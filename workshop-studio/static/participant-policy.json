{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkshopNamedResources",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "lambda:*",
        "ecr:*",
        "codebuild:*"
      ],
      "Resource": [
        "arn:aws:s3:::loanbuddy-*",
        "arn:aws:s3:::loanbuddy-*/*",
        "arn:aws:s3:::bedrock-agentcore-*",
        "arn:aws:s3:::bedrock-agentcore-*/*",
        "arn:aws:dynamodb:*:*:table/loanbuddy-*",
        "arn:aws:lambda:*:*:function:loanbuddy-*",
        "arn:aws:ecr:*:*:repository/bedrock-agentcore-*",
        "arn:aws:codebuild:*:*:project/bedrock-agentcore-*",
        "arn:aws:codebuild:*:*:build/bedrock-agentcore-*"
      ]
    },
    {
      "Sid": "WorkshopStack",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:*:*:stack/loanbuddy-workshop*/*"
    },
    {
      "Sid": "AccountLevelActionsNoResourceSupport",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStacks",
        "ecr:GetAuthorizationToken",
        "s3:ListAllMyBuckets",
        "codebuild:ListBuilds",
        "codebuild:BatchGetBuilds",
        "sts:GetCallerIdentity",
        "sts:DecodeAuthorizationMessage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServicesWithUnpredictableResourceIds",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:*",
        "cloudfront:*",
        "apigateway:*",
        "logs:*",
        "cloudwatch:*",
        "xray:*",
        "application-signals:StartDiscovery",
        "cloudtrail:CreateServiceLinkedChannel",
        "bedrock:*",
        "bedrock-agentcore:*",
        "cloudshell:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IdentityTokenVaultSecretsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:*:*:secret:bedrock-agentcore-identity!*"
    },
    {
      "Sid": "MarketplaceActionsHaveNoResourceLevelSupport",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:Subscribe",
        "aws-marketplace:ViewSubscriptions",
        "aws-marketplace:Unsubscribe"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamWorkshopRolePrefixesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/loanbuddy-*",
        "arn:aws:iam::*:role/*BedrockAgentCore*",
        "arn:aws:iam::*:role/*bedrock-agentcore*",
        "arn:aws:iam::*:role/agentcore-*",
        "arn:aws:iam::*:role/AgentCore*"
      ]
    },
    {
      "Sid": "ServiceLinkedRolesForWorkshopServices",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*"
    }
  ]
}
